{
  "manifest_version": 3,
  "name": "SpotApply Autofill",
  "version": "1.4.0",
  "description": "Fills job applications on Greenhouse, Lever, Ashby, Workday and more from your SpotApply profile. You review and submit.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "*://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SpotApply Autofill"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
