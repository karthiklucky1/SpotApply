# Copy to .env and fill in. EXPO_PUBLIC_* vars are inlined into the app bundle
# at build time — only ever put PUBLIC values here (the anon key is public by
# design; never the service-role key).

# SpotApply backend (FastAPI). Point at a local dev server if you run one,
# e.g. http://192.168.1.20:8000 (your machine's LAN IP — not localhost, the
# phone can't reach that).
EXPO_PUBLIC_API_URL=https://app.spotapply.ai

# Same Supabase project the web app uses (Settings → API in Supabase).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
