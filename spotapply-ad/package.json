{
  "name": "spotapply-ad",
  "version": "1.0.0",
  "description": "SpotApply 30-second vertical social ad (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/paths": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render SpotApplySocial30 out/spotapply-social-30s.mp4 --codec=h264 --crf=16 --x264-preset=slow --image-format=png --color-space=bt709",
    "poster": "remotion still SpotApplySocial30 out/spotapply-social-30s-poster.png --frame=278 --image-format=png",
    "frames": "remotion render SpotApplySocial30 out/frames --frames=45,100,150,240,262,318,400,470,540,632,700,749,820,899 --image-format=png",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "captions": "node --no-warnings voiceover/make-srt.mjs",
    "render:silent": "remotion render SpotApplySocial30 out/spotapply-social-30s-silent.mp4 --props={\"voiceover\":false} --codec=h264 --crf=16 --x264-preset=slow --image-format=png --color-space=bt709",
    "captions:60": "node --no-warnings voiceover/make-srt.mjs 60",
    "render:60": "remotion render SpotApplyExplainer60 out/spotapply-explainer-60s.mp4 --codec=h264 --crf=16 --x264-preset=slow --image-format=png --color-space=bt709",
    "poster:60": "remotion still SpotApplyExplainer60 out/spotapply-explainer-60s-poster.png --frame=540 --image-format=png",
    "render:reel": "remotion render SpotApplyReel60 out/spotapply-reel-60s.mp4 --codec=h264 --crf=16 --x264-preset=slow --image-format=png --color-space=bt709",
    "captions:reel": "node --no-warnings voiceover/make-srt-reel.mjs",
    "poster:reel": "remotion still SpotApplyReel60 out/spotapply-reel-60s-poster.png --frame=760 --image-format=png"
  }
}
